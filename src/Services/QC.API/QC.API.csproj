    <ProjectReference Include="..\..\SharedLib\Shared.Infrastructure\Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\..\SharedLib\Shared.Logging\Shared.Logging.csproj" />
  </ItemGroup>

