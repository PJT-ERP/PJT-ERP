{
  "Jwt": {
    "Issuer": "PJT-ERP.Identity",
    "Audience": "PJT-ERP.Web"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://innovation-pratama.co.id",
      "https://www.innovation-pratama.co.id",
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "analytics": {
        "ClusterId": "production",
        "AuthorizationPolicy": "AnalyticsPolicy",
        "Match": {
          "Path": "/api/v1/analytics/{**catch-all}"
        }
      },
      "masterdata": {
        "ClusterId": "masterdata",
        "Match": {
          "Path": "/api/v1/master-data/{**catch-all}"
        }
      },
      "production": {
        "ClusterId": "production",
        "Match": {
          "Path": "/api/v1/production/{**catch-all}"
        }
      },
      "sales": {
        "ClusterId": "production",
        "Match": {
          "Path": "/api/v1/sales/{**catch-all}"
        }
      },
      "qc": {
        "ClusterId": "qc",
        "Match": {
          "Path": "/api/v1/qc/{**catch-all}"
        }
      },
      "purchasing": {
        "ClusterId": "purchasing",
        "Match": {
          "Path": "/api/v1/purchasing/{**catch-all}"
        }
      },
      "finance": {
        "ClusterId": "finance",
        "AuthorizationPolicy": "FinancePolicy",
        "Match": {
          "Path": "/api/v1/finance/{**catch-all}"
        }
      },
      "finance-proofs": {
        "ClusterId": "finance",
        "Match": {
          "Path": "/proofs/{**catch-all}"
        }
      },
      "identity-openapi": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/openapi/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "masterdata-openapi": {
        "ClusterId": "masterdata",
        "Match": {
          "Path": "/openapi/masterdata/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "production-openapi": {
        "ClusterId": "production",
        "Match": {
          "Path": "/openapi/production/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "qc-openapi": {
        "ClusterId": "qc",
        "Match": {
          "Path": "/openapi/qc/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "purchasing-openapi": {
        "ClusterId": "purchasing",
        "Match": {
          "Path": "/openapi/purchasing/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "finance-openapi": {
        "ClusterId": "finance",
        "Match": {
          "Path": "/openapi/finance/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identityApi": {
            "Address": "http://identity-api:8080/"
          }
        }
      },
      "masterdata": {
        "Destinations": {
          "masterdataApi": {
            "Address": "http://masterdata-api:8080/"
          }
        }
      },
      "production": {
        "Destinations": {
          "productionApi": {
            "Address": "http://production-api:8080/"
          }
        }
      },
      "qc": {
        "Destinations": {
          "qcApi": {
            "Address": "http://qc-api:8080/"
          }
        }
      },
      "purchasing": {
        "Destinations": {
          "purchasingApi": {
            "Address": "http://purchasing-api:8080/"
          }
        }
      },
      "finance": {
        "Destinations": {
          "financeApi": {
            "Address": "http://finance-api:8080/"
          }
        }
      }
    }
  }
}
