{
  "Jwt": {
    "Issuer": "PJT-HIMTIKA.Identity",
    "Audience": "PJT-HIMTIKA.Web"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "masterdata": {
        "ClusterId": "masterdata",
        "Match": {
          "Path": "/api/v1/master-data/{**catch-all}"
        }
      },
      "production": {
        "ClusterId": "production",
        "Match": {
          "Path": "/api/v1/production/{**catch-all}"
        }
      },
      "qc": {
        "ClusterId": "qc",
        "Match": {
          "Path": "/api/v1/qc/{**catch-all}"
        }
      },
      "purchasing": {
        "ClusterId": "purchasing",
        "Match": {
          "Path": "/api/v1/purchasing/{**catch-all}"
        }
      },
      "identity-openapi": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/openapi/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "masterdata-openapi": {
        "ClusterId": "masterdata",
        "Match": {
          "Path": "/openapi/masterdata/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "production-openapi": {
        "ClusterId": "production",
        "Match": {
          "Path": "/openapi/production/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "qc-openapi": {
        "ClusterId": "qc",
        "Match": {
          "Path": "/openapi/qc/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "purchasing-openapi": {
        "ClusterId": "purchasing",
        "Match": {
          "Path": "/openapi/purchasing/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identityApi": {
            "Address": "http://identity-api:8080/"
          }
        }
      },
      "masterdata": {
        "Destinations": {
          "masterdataApi": {
            "Address": "http://masterdata-api:8080/"
          }
        }
      },
      "production": {
        "Destinations": {
          "productionApi": {
            "Address": "http://production-api:8080/"
          }
        }
      },
      "qc": {
        "Destinations": {
          "qcApi": {
            "Address": "http://qc-api:8080/"
          }
        }
      },
      "purchasing": {
        "Destinations": {
          "purchasingApi": {
            "Address": "http://purchasing-api:8080/"
          }
        }
      }
    }
  }
}
