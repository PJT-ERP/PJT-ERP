{
  "name": "PJT ERP API Catalog",
  "version": "v1",
  "purpose": "Human/frontend reference for gateway endpoints, roles, and sample payloads. Runtime routing still uses YARP ReverseProxy config in src/ApiGateways/Web.Gateway/appsettings.json.",
  "gateway": {
    "reverseProxy": "YARP",
    "localBaseUrl": "http://localhost:5000",
    "scalarUrl": "http://localhost:5000/scalar",
    "openApiDocuments": {
      "identity": "/openapi/identity/v1.json",
      "masterdata": "/openapi/masterdata/v1.json",
      "production": "/openapi/production/v1.json",
      "qc": "/openapi/qc/v1.json",
      "purchasing": "/openapi/purchasing/v1.json",
      "finance": "/openapi/finance/v1.json"
    }
  },
  "auth": {
    "developmentMasterToken": {
      "enabledOnlyWhen": "ASPNETCORE_ENVIRONMENT=Development",
      "token": "dev-master-token",
      "authorizationHeader": "Bearer dev-master-token",
      "rolesGranted": [
        "Admin",
        "Owner",
        "Sales Order",
        "Finance",
        "Engineering Supervisor",
        "Engineering Worker",
        "Purchasing"
      ]
    }
  },
  "roles": [
    "Sales Order",
    "Finance",
    "Engineering Supervisor",
    "Engineering Worker",
    "Purchasing",
    "Owner",
    "Admin"
  ],
  "roleModel": {
    "productionTracking": {
      "summary": "Sales Order is the visible tracking root. ProductionOrder rows are internal workflow state only.",
      "writeAccess": {
        "salesOrderCreationConfirmationAndEngineerAssignment": ["Admin", "Sales Order"],
        "salesOrderProductionStartFinish": ["Admin", "Engineering Worker"],
        "salesOrderDrawingUpload": ["Admin", "Engineering Worker"],
        "salesOrderMaterialRequest": ["Admin", "Engineering Worker"],
        "barcodeLookup": ["Admin", "Owner", "Sales Order", "Finance", "Engineering Worker", "Purchasing"]
      },
      "readAccess": {
        "salesOrderProgress": ["Sales Order", "Finance", "Engineering Worker", "Purchasing", "Owner", "Admin"],
        "publicCustomerTracking": "anonymous"
      }
    },
    "qc": {
      "summary": "QC is image/form upload, notes, and Go/NoGo decision by Engineering Supervisor. There are no visual/dimension checklist endpoints.",
      "writeAccess": {
        "qcResultUpload": ["Admin", "Engineering Supervisor"]
      },
      "readAccess": {
        "qcInspections": ["Admin", "Owner", "Engineering Supervisor"]
      }
    },
    "finance": {
      "summary": "Finance invoices are created from completed Sales Orders. Invoice item rows are copied from SO items; Finance fills prices, DP/payment schedule, due dates, payment records, and collection letters.",
      "writeAccess": {
        "invoiceCreationPaymentAndCollectionLetters": ["Admin", "Finance"]
      },
      "readAccess": {
        "invoicesCandidatesAndDashboard": ["Admin", "Finance", "Owner"]
      }
    }
  },
  "endpoints": [
    {
      "service": "Production.API",
      "feature": "Sales Orders",
      "method": "POST",
      "path": "/api/v1/production/sales-orders",
      "roles": ["Admin", "Sales Order"],
      "description": "Create a Sales Order with one or more item lines, customer drawing/design reference, and optional engineer worker/reviewer assignment.",
      "requestBody": {
        "customerId": "00000000-0000-0000-0000-000000000000",
        "soDate": "2026-05-22",
        "targetDate": "2026-05-29",
        "customerDrawingUrl": "https://drive.example/customer-design-input.jpg",
        "designReference": "DESIGN-2026-001",
        "designStatus": "PendingDesign",
        "productionWorker": {
          "userId": "00000000-0000-0000-0000-000000000001",
          "name": "Engineering Worker"
        },
        "qcReviewer": {
          "userId": "00000000-0000-0000-0000-000000000002",
          "name": "Engineering Supervisor"
        },
        "items": [
          {
            "productId": "00000000-0000-0000-0000-000000000003",
            "qty": 10,
            "notes": "Urgent"
          }
        ]
      }
    },
    {
      "service": "Production.API",
      "feature": "Sales Orders",
      "method": "PUT",
      "path": "/api/v1/production/sales-orders/{id}/engineers",
      "roles": ["Admin", "Sales Order"],
      "description": "Assign or update the Engineering Worker responsible for the Sales Order."
    },
    {
      "service": "Production.API",
      "feature": "Design Approval",
      "method": "PUT",
      "path": "/api/v1/production/sales-orders/{id}/design-status",
      "roles": ["Admin", "Engineering Supervisor"],
      "description": "Engineering Supervisor updates design status. Sales Order confirmation requires designStatus Approved.",
      "requestBody": {
        "designStatus": "Approved",
        "reviewedByUserId": "00000000-0000-0000-0000-000000000002",
        "reviewerName": "Engineering Supervisor",
        "designReference": "DESIGN-2026-001",
        "customerDrawingUrl": "https://drive.example/customer-design-input.jpg"
      },
      "allowedValues": {
        "designStatus": ["PendingDesign", "WaitingApproval", "Approved", "RevisionRequired", "Rejected"]
      }
    },
    {
      "service": "Production.API",
      "feature": "Sales Orders",
      "method": "POST",
      "path": "/api/v1/production/sales-orders/{id}/confirm",
      "roles": ["Admin", "Sales Order"],
      "description": "Confirm an approved-design Sales Order and prepare internal production tracking. Response is SO tracking, not an internal workflow object."
    },
    {
      "service": "Production.API",
      "feature": "Sales Order Tracking",
      "method": "GET",
      "path": "/api/v1/production/sales-orders/{id}/progress",
      "roles": ["Sales Order", "Finance", "Engineering Worker", "Purchasing", "Owner", "Admin"],
      "description": "Read Sales Order production progress, assignment, drawing, barcode, timestamps, duration, and item lines."
    },
    {
      "service": "Production.API",
      "feature": "Sales Order Tracking",
      "method": "POST",
      "path": "/api/v1/production/tracking/lookup",
      "roles": ["Admin", "Owner", "Sales Order", "Finance", "Engineering Worker", "Purchasing"],
      "description": "Lookup Sales Order tracking by SO number or barcode. This endpoint is read-only.",
      "requestBody": {
        "trackingCode": "SO-20260522120000-ABCDEF"
      }
    },
    {
      "service": "Production.API",
      "feature": "Sales Order Production",
      "method": "PUT",
      "path": "/api/v1/production/sales-orders/{id}/production/start",
      "roles": ["Admin", "Engineering Worker"],
      "description": "Start production for the Sales Order. Only the assigned worker can update it."
    },
    {
      "service": "Production.API",
      "feature": "Sales Order Production",
      "method": "PUT",
      "path": "/api/v1/production/sales-orders/{id}/production/finish",
      "roles": ["Admin", "Engineering Worker"],
      "description": "Finish production for the Sales Order and publish the production-finished workflow event."
    },
    {
      "service": "Production.API",
      "feature": "Engineering Drawing",
      "method": "PUT",
      "path": "/api/v1/production/sales-orders/{id}/engineering-drawing",
      "roles": ["Admin", "Engineering Worker"],
      "description": "Upload/input an engineering drawing link against the Sales Order. Only the assigned Engineering Worker can upload it."
    },
    {
      "service": "Production.API",
      "feature": "Material Requests",
      "method": "POST",
      "path": "/api/v1/production/sales-orders/{id}/material-requests",
      "roles": ["Admin", "Engineering Worker"],
      "description": "Assigned Engineering Worker submits a multi-item MR from the Production/SO context. Production publishes MaterialRequestSubmittedEvent and Purchasing creates the submitted MR for Supervisor approval.",
      "requestBody": {
        "requestedByUserId": "00000000-0000-0000-0000-000000000010",
        "requesterName": "Engineering Worker",
        "notes": "Material shortage before production start.",
        "items": [
          {
            "materialRequirementId": null,
            "salesOrderItemId": "00000000-0000-0000-0000-000000000012",
            "itemName": "S45C Round Bar",
            "size": "Diameter 10mm",
            "qty": 2,
            "urgency": "Urgent",
            "suggestedSupplier": "PT. Steel",
            "notes": "Stock shortage",
            "purchaseCategory": "Project"
          },
          {
            "materialRequirementId": null,
            "salesOrderItemId": null,
            "itemName": "Coolant",
            "size": "Water soluble",
            "qty": 1,
            "urgency": "Normal",
            "purchaseCategory": "Consumable"
          }
        ]
      }
    },
    {
      "service": "Production.API",
      "feature": "Public Tracking",
      "method": "GET",
      "path": "/api/v1/production/tracking?code={soNumberOrBarcode}",
      "roles": [],
      "auth": "anonymous",
      "description": "Public/customer read-only tracking by SO number or barcode. SO customer drawing/design reference can be shown for tracking context; internal identifiers, barcode UID, uploader IDs, and QC decisions are hidden."
    },
    {
      "service": "QC.API",
      "feature": "QC Inspection",
      "method": "GET",
      "path": "/api/v1/qc/inspections",
      "roles": ["Admin", "Owner", "Engineering Supervisor"],
      "description": "List QC inspection records prepared by the Sales Order workflow for Engineering Supervisor QC."
    },
    {
      "service": "QC.API",
      "feature": "QC Result",
      "method": "PUT",
      "path": "/api/v1/qc/inspections/{id}/result",
      "roles": ["Admin", "Engineering Supervisor"],
      "description": "Upload QC image/form URL, notes, and Go/NoGo decision.",
      "requestBody": {
        "reviewerUserId": "00000000-0000-0000-0000-000000000002",
        "reviewerName": "Engineering Supervisor",
        "qcImageUrl": "https://drive.example/qc-form.jpg",
        "notes": "Visual condition acceptable.",
        "decision": "Go"
      },
      "allowedValues": {
        "decision": ["Go", "NoGo"]
      }
    },
    {
      "service": "Purchasing.API",
      "feature": "Material Requirements",
      "method": "GET",
      "path": "/api/v1/purchasing/material-requirements?salesOrderId={salesOrderId}",
      "roles": ["Admin", "Finance", "Engineering Worker", "Purchasing", "Owner", "Sales Order"],
      "description": "List material requirements by Sales Order with stock visibility."
    },
    {
      "service": "Purchasing.API",
      "feature": "Material Stock",
      "method": "PUT",
      "path": "/api/v1/purchasing/material-requirements/{id}/stock",
      "roles": ["Admin", "Purchasing"],
      "description": "Update stock on hand and stock notes for a material requirement."
    },
    {
      "service": "Purchasing.API",
      "feature": "Purchase Requests",
      "method": "GET",
      "path": "/api/v1/purchasing/purchase-requests",
      "roles": ["Admin", "Finance", "Engineering Worker", "Purchasing", "Owner", "Sales Order"],
      "description": "List purchase requests submitted by Engineering, approved by Engineering Supervisor, approved by Finance, and handled by Purchasing. UI can filter by status or Sales Order."
    },
    {
      "service": "Purchasing.API",
      "feature": "Purchase Requests",
      "method": "GET",
      "path": "/api/v1/purchasing/purchase-requests/{id}",
      "roles": ["Admin", "Finance", "Engineering Worker", "Purchasing", "Owner", "Sales Order"],
      "description": "Open purchase request detail with item, urgency, requester, SO reference, Supervisor review data, Finance review data, supplier, PO number, total price, calculated unit price, ETA, received date, and notes."
    },
    {
      "service": "Purchasing.API",
      "feature": "Purchase Requests",
      "method": "POST",
      "path": "/api/v1/purchasing/purchase-requests",
      "roles": ["Admin", "Engineering Worker"],
      "description": "Engineering Worker submits a multi-item purchase request.",
      "requestBody": {
        "requestDate": "2026-05-22",
        "requestedByUserId": "00000000-0000-0000-0000-000000000010",
        "requesterName": "Engineering Worker",
        "salesOrderId": "00000000-0000-0000-0000-000000000011",
        "salesOrderNumber": "SO-20260522120000-ABCDEF",
        "projectName": "SO-20260522120000-ABCDEF",
        "items": [
          {
            "materialRequirementId": "00000000-0000-0000-0000-000000000012",
            "itemName": "Carbide End Mill Ø12mm",
            "size": "4 Flute, TiAIN Coating, L=75mm",
            "qty": 20,
            "urgency": "Normal",
            "purchaseCategory": "Tools",
            "totalPrice": 7300000,
            "suggestedSupplier": "PT. Krakatau Steel",
            "notes": "Stok cutting tool untuk mesin CNC"
          }
        ]
      }
    },
    {
      "service": "Purchasing.API",
      "feature": "Purchase Requests",
      "method": "POST",
      "path": "/api/v1/purchasing/purchase-requests/{id}/supervisor-review",
      "roles": ["Admin", "Engineering Supervisor"],
      "description": "Engineering Supervisor accepts or rejects a submitted purchase request before it can move to Finance approval.",
      "requestBody": {
        "reviewedByUserId": "00000000-0000-0000-0000-000000000021",
        "decision": "Accept",
        "rejectionReason": null
      }
    },
    {
      "service": "Purchasing.API",
      "feature": "Purchase Requests",
      "method": "POST",
      "path": "/api/v1/purchasing/purchase-requests/{id}/finance-review",
      "roles": ["Admin", "Finance"],
      "description": "Finance accepts or rejects a Supervisor-approved purchase request before Purchasing can process items.",
      "requestBody": {
        "reviewedByUserId": "00000000-0000-0000-0000-000000000020",
        "decision": "Accept",
        "rejectionReason": null
      }
    },
    {
      "service": "Purchasing.API",
      "feature": "Purchase Requests",
      "method": "POST",
      "path": "/api/v1/purchasing/purchase-requests/{id}/review",
      "roles": ["Admin", "Finance"],
      "description": "Backward-compatible alias for Finance review.",
      "requestBody": {
        "reviewedByUserId": "00000000-0000-0000-0000-000000000020",
        "decision": "Accept",
        "rejectionReason": null
      }
    },
    {
      "service": "Purchasing.API",
      "feature": "Purchase Request Item",
      "method": "PUT",
      "path": "/api/v1/purchasing/purchase-requests/{id}/items/{itemId}/process",
      "roles": ["Admin", "Purchasing"],
      "description": "Purchasing processes a Finance-approved item by filling supplier, PO number, total price, ETA, category, and purchasing notes. Unit price is calculated by the API from totalPrice / qty.",
      "requestBody": {
        "supplierName": "PT. Krakatau Steel",
        "expectedArrivalDate": "2026-05-25",
        "poNumber": "PO-2026-041",
        "totalPrice": 7300000,
        "purchaseCategory": "Tools",
        "purchaseNotes": "Stok cutting tool untuk mesin CNC"
      }
    },
    {
      "service": "Purchasing.API",
      "feature": "Purchase Request Item",
      "method": "PUT",
      "path": "/api/v1/purchasing/purchase-requests/{id}/items/{itemId}/reject",
      "roles": ["Admin", "Purchasing"],
      "description": "Purchasing rejects a purchase request item and records the rejection reason.",
      "requestBody": {
        "rejectionReason": "Request material tidak valid"
      }
    },
    {
      "service": "Purchasing.API",
      "feature": "Purchase Request Item",
      "method": "PUT",
      "path": "/api/v1/purchasing/purchase-requests/{id}/items/{itemId}/receive",
      "roles": ["Admin", "Purchasing"],
      "description": "Purchasing confirms material receipt using the actual received date.",
      "requestBody": {
        "receivedDate": "2026-05-24",
        "purchaseNotes": "Barang diterima lengkap"
      }
    },
    {
      "service": "Purchasing.API",
      "feature": "Purchase Requests",
      "method": "PUT",
      "path": "/api/v1/purchasing/purchase-requests/{id}/items/{itemId}/purchase-info",
      "roles": ["Admin", "Purchasing"],
      "description": "Compatibility endpoint to record or patch supplier, PO number, total price, purchase category, purchase date, arrival estimate, received date, purchase status, and notes."
    },
    {
      "service": "Purchasing.API",
      "feature": "Sales Order Material Tracking",
      "method": "GET",
      "path": "/api/v1/purchasing/sales-orders/{salesOrderId}/material-tracking",
      "roles": ["Admin", "Finance", "Engineering Worker", "Purchasing", "Owner", "Sales Order"],
      "description": "Track raw material progress from one Sales Order, including requirement counts and linked purchasing item status."
    },
    {
      "service": "Finance.API",
      "feature": "Invoice Candidates",
      "method": "GET",
      "path": "/api/v1/finance/invoice-candidates?customerId={customerId}",
      "roles": ["Admin", "Finance", "Owner"],
      "description": "List completed Sales Orders that are ready to be invoiced. Rows are created automatically after QC returns Go for the production order."
    },
    {
      "service": "Finance.API",
      "feature": "Invoices",
      "method": "GET",
      "path": "/api/v1/finance/invoices?customerId={customerId}&dueFrom={date}&dueTo={date}&status={status}&sortBy=dueDateAsc",
      "roles": ["Admin", "Finance", "Owner"],
      "description": "List invoices with due date filter, customer filter, status filter, and date sorting for Riwayat Transaksi Finance."
    },
    {
      "service": "Finance.API",
      "feature": "Invoices",
      "method": "POST",
      "path": "/api/v1/finance/invoices",
      "roles": ["Admin", "Finance"],
      "description": "Create an invoice from a completed Sales Order. Item rows come from SO; Finance only sends unit prices and payment schedules.",
      "requestBody": {
        "salesOrderId": "00000000-0000-0000-0000-000000000011",
        "invoiceDate": "2026-06-08",
        "dueDate": "2026-06-22",
        "taxPercent": 11,
        "items": [
          {
            "salesOrderItemId": "00000000-0000-0000-0000-000000000012",
            "unitPrice": 100000
          }
        ],
        "paymentSchedules": [
          {
            "label": "DP 50%",
            "percentage": 50,
            "dueDate": "2026-06-12"
          },
          {
            "label": "Pelunasan 50%",
            "percentage": 50,
            "dueDate": "2026-06-22"
          }
        ],
        "bankName": "BCA",
        "bankAccountName": "PT PJT",
        "bankAccountNumber": "1234567890"
      }
    },
    {
      "service": "Finance.API",
      "feature": "Payments",
      "method": "POST",
      "path": "/api/v1/finance/invoices/{invoiceId}/payments",
      "roles": ["Admin", "Finance"],
      "description": "Record DP or remaining payment. API recalculates paid amount, remaining amount, payment percentage, and invoice status."
    },
    {
      "service": "Finance.API",
      "feature": "Collection Letters",
      "method": "POST",
      "path": "/api/v1/finance/invoices/{invoiceId}/collection-letters",
      "roles": ["Admin", "Finance"],
      "description": "Create Surat Penagihan for unpaid invoices after the due date. This is separate from invoice printout."
    },
    {
      "service": "Finance.API",
      "feature": "Finance Dashboard",
      "method": "GET",
      "path": "/api/v1/finance/dashboard?customerId={customerId}",
      "roles": ["Admin", "Finance", "Owner"],
      "description": "Return billing, paid, outstanding, overdue, and payment progress metrics. If customerId is supplied, dashboard is scoped to one customer."
    }
  ]
}
