FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html postcss.config.mjs vite.config.ts tsconfig.json ./
COPY public ./public
COPY src/app ./src/app
COPY src/styles ./src/styles
COPY src/main.tsx src/setupTests.ts src/vite-env.d.ts ./src/
ARG VITE_API_BASE_URL=http://localhost:5000
ARG VITE_DEV_MASTER_TOKEN=dev-master-token
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_DEV_MASTER_TOKEN=$VITE_DEV_MASTER_TOKEN
ENV NODE_OPTIONS="--max-old-space-size=2048"

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
